# ==============================================================================
# J.A.R.V.I.S. Security Suite — Environment Variables
# ==============================================================================
#
# 1. Copy this file to .env.local (frontend) and .env (backend), then fill in
#    the values that apply to your deployment.
#
# 2. NEVER commit .env.local or .env to version control.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Next.js) — copy to .env.local
# ------------------------------------------------------------------------------

# Auth adapter selection:
#   "mock"     — self-contained demo adapter (works out of the box, no backend)
#   "backend"  — integrates with the FastAPI auth service (see below)
#   Custom adapters can be injected programmatically via <AuthProvider>.
NEXT_PUBLIC_AUTH_ADAPTER=mock

# Base URL of the FastAPI backend. Only required when NEXT_PUBLIC_AUTH_ADAPTER=backend.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend (FastAPI) — copy to app/python-backend/.env
# ------------------------------------------------------------------------------

# JWT signing secret — REQUIRED in production. Generate with:
#   openssl rand -hex 64
JARVIS_JWT_SECRET=

# CORS: comma-separated list of allowed origins (the Next.js frontend URL).
JARVIS_CORS_ORIGINS=http://localhost:3000

# Database URL. SQLite is default for development; swap to Postgres for production.
# Example Postgres: postgresql+asyncpg://user:pass@localhost:5432/jarvis_auth
JARVIS_DB_URL=sqlite:///jarvis_auth.db

# ------------------------------------------------------------------------------
# Optional: Demo mode (NOT for production)
# ------------------------------------------------------------------------------

# Set to "true" to allow any valid email + 6+ char passkey to auto-login in
# MockAuthAdapter without explicit registration. Disable in production.
# JARVIS_DEMO_MODE=false
