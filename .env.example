# J.A.R.V.I.S. Auth Adapter Mode
# - "mock"     : Fully self-contained demo (no backend needed - works out of the box)
# - "backend"  : Integrates with Python FastAPI auth service
# - "firebase" : (reserved) Hooks into Firebase Auth / Firestore
NEXT_PUBLIC_AUTH_ADAPTER=mock

# Required when NEXT_PUBLIC_AUTH_ADAPTER=backend
# Example: http://localhost:8000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000

# ----- Reserved for future Firebase integration -----
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
